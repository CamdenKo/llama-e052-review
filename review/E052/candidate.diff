+// Check Metal's exact -inf exclusion with explicit outputs; CPU is not an exceptional-value oracle.
+static bool run_metal_indexer_exclusion(ggml_backend_t backend, const char * op_names_filter,
+                                        const char * params_filter, printer * output_printer) {
+    auto * reg = ggml_backend_dev_backend_reg(ggml_backend_get_device(backend));
+    if (strcmp(ggml_backend_reg_name(reg), "MTL") != 0) {
+        return true;
+    }
+    if (!op_names_filter_selects(op_names_filter, "LIGHTNING_INDEXER")) {
+        return true;
+    }
+    bool all_ok = true;
+    size_t n_run = 0, n_fail = 0;
+    for (int nh : { 4, 32 }) {
+        for (int kv : { 63, 65, 193 }) {
+            for (int nb : { 1, 7, 9, 20 }) {
+                for (int exceptional : { 1, 2, 3, 4 }) {
+                    std::string vars = VARS_TO_STR4(nh, kv, nb, exceptional) + ",metal_exclusion=1";
+                    if (params_filter && !std::regex_search(vars, std::regex(params_filter))) {
+                        continue;
+                    }
+                    ggml_init_params params = {ggml_tensor_overhead()*16 + ggml_graph_overhead(), nullptr, true};
+                    ggml_context_ptr ctx(ggml_init(params));
+                    ggml_tensor * q = ggml_new_tensor_4d(ctx.get(), GGML_TYPE_F32, 128, nh, nb, 1);
+                    ggml_tensor * k = ggml_new_tensor_4d(ctx.get(), GGML_TYPE_F32, 128, 1, kv, 1);
+                    ggml_tensor * w = ggml_new_tensor_2d(ctx.get(), GGML_TYPE_F32, nh, nb);
+                    ggml_tensor * m = ggml_new_tensor_2d(ctx.get(), GGML_TYPE_F16, kv, nb);
+                    ggml_tensor * before = ggml_new_tensor_1d(ctx.get(), GGML_TYPE_F32, 1024);
+                    ggml_tensor * out = ggml_lightning_indexer(ctx.get(), q, k, w, m);
+                    ggml_tensor * after = ggml_new_tensor_1d(ctx.get(), GGML_TYPE_F32, 1024);
+                    ggml_backend_buffer_ptr buf(ggml_backend_alloc_ctx_tensors(ctx.get(), backend));
+                    if (!buf) {
+                        return false;
+                    }
+                    GGML_ASSERT((char *) before->data + ggml_nbytes(before) == (char *) out->data);
+                    GGML_ASSERT((char *) out->data + GGML_PAD(ggml_nbytes(out), ggml_backend_get_alignment(backend)) == (char *) after->data);
+                    std::vector<float> qv(128*nh*nb, 1.0f), kvals(128*kv, 1.0f), wv(nh*nb, 1.0f);
+                    const float corrupt = exceptional == 1 ? 100000.0f : exceptional == 2 ? INFINITY : std::numeric_limits<float>::quiet_NaN();
+                    std::fill(kvals.begin(), kvals.begin() + 128, corrupt);
+                    std::vector<ggml_fp16_t> mv(kv*nb);
+                    std::vector<float> expected(kv*nb);
+                    for (int ib = 0; ib < nb; ++ib) {
+                        const bool hidden = nb == 1 || ib < 8 || ib%3 == 0;
+                        if (exceptional == 4 && hidden) {
+                            std::fill(wv.begin() + ib*nh, wv.begin() + (ib + 1)*nh, corrupt);
+                        }
+                        for (int ik = 0; ik < kv; ++ik) {
+                            // key 0 is always hidden; full hidden tiles and an active final tail.
+                            const bool live = !hidden && ((ik > 0 && ik < 32) || ik == kv - 1);
+                            const float mask = live ? -0.25f : -INFINITY;
+                            mv[ib*kv + ik] = ggml_fp32_to_fp16(mask);
+                            expected[ib*kv + ik] = live ? float(128*nh) + mask : -INFINITY;
+                        }
+                    }
+                    std::vector<float> guard(1024, 12345.0f), poison(kv*nb, 12345.0f);
+                    ggml_backend_tensor_set(before, guard.data(), 0, ggml_nbytes(before));
+                    ggml_backend_tensor_set(after, guard.data(), 0, ggml_nbytes(after));
+                    ggml_backend_tensor_set(q, qv.data(), 0, ggml_nbytes(q));
+                    ggml_backend_tensor_set(k, kvals.data(), 0, ggml_nbytes(k));
+                    ggml_backend_tensor_set(w, wv.data(), 0, ggml_nbytes(w));
+                    ggml_backend_tensor_set(m, mv.data(), 0, ggml_nbytes(m));
+                    ggml_backend_tensor_set(out, poison.data(), 0, ggml_nbytes(out));
+                    ggml_cgraph * graph = ggml_new_graph(ctx.get());
+                    ggml_build_forward_expand(graph, out);
+                    bool ok = ggml_backend_graph_compute(backend, graph) == GGML_STATUS_SUCCESS;
+                    std::vector<float> observed(kv*nb), observed_guard(1024);
+                    ggml_backend_tensor_get(out, observed.data(), 0, ggml_nbytes(out));
+                    ok &= memcmp(observed.data(), expected.data(), ggml_nbytes(out)) == 0;
+                    ggml_backend_tensor_get(before, observed_guard.data(), 0, ggml_nbytes(before));
+                    ok &= observed_guard == guard;
+                    ggml_backend_tensor_get(after, observed_guard.data(), 0, ggml_nbytes(after));
+                    ok &= observed_guard == guard;
+                    test_result result(ggml_backend_name(backend), "LIGHTNING_INDEXER", vars, "test", true, ok,
+                                       ok ? "" : "Metal exclusion output/sentinel mismatch");
+                    print_test_result_locked(output_printer, result);
+                    all_ok &= ok;
+                    ++n_run;
+                    n_fail += !ok;
+                }
+            }
+        }
+    }
+    printf("  Metal indexer exclusion: %zu cases run, %zu failed\n", n_run, n_fail);
+    return all_ok;
+}
